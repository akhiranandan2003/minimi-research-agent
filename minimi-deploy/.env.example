# OpenAI model access (server only)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5.5

# Tavily is the application's ONLY external tool
TAVILY_API_KEY=your_tavily_api_key

# Supabase project settings
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Public anon/publishable key. The API validates the user's access token and RLS scopes every query.
SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key

# The same public Supabase values are used by the React sign-in screen.
# These are safe to expose; never put a service-role/secret key in a VITE_ variable.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key

# Local development
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3001
