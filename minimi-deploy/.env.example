# OpenAI model access (server only)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5.5

# Tavily is the application's ONLY external tool
TAVILY_API_KEY=your_tavily_api_key

# Supabase project -> Project Settings -> API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Use a server-side secret/service-role key only. Never put this in VITE_ variables.
SUPABASE_SERVICE_ROLE_KEY=your_server_side_supabase_secret_key

# Local development
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3001
