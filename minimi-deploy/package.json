{
  "name": "minimi-research-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": ["server", "client"],
  "scripts": {
    "dev": "concurrently -n API,WEB -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --workspace server run dev",
    "dev:client": "npm --workspace client run dev",
    "test": "npm --workspace server test",
    "build": "npm --workspace client run build"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
